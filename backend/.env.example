# 复制这个文件为 .env，填入真实的 key（.env 不会被提交到 git，见 .gitignore）
# 图片生成 / 图片编辑（AI消除去水印）/ 文字生成（写作+翻译）共用
OPENLUX_BASE_URL=https://api.openlux.ai/v1
OPENLUX_API_KEY=

# 视频生成（Vidu）。如果跟上面是同一个 openlux 账号，这两行可以留空，会自动复用 OPENLUX_API_KEY
VIDU_BASE_URL=
VIDU_API_KEY=

# 登录 token 签名密钥。留空则首次启动自动生成一个随机值并存到 backend/.jwt_secret 文件，不用手动填
JWT_SECRET=

# 博查 Web Search API（联网搜索→提炼内容→source 字段这条链路用），https://open.bochaai.com/ 申请
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_API_KEY=
